{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heron",
  "version": "0.1.0",
  "identifier": "io.greyheron.heron",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Heron",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
