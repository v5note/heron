{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only what the UI needs: no filesystem access from the webview.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "autostart:default",
    "core:menu:allow-new",
    "core:menu:allow-set-as-app-menu",
    "core:menu:allow-set-as-window-menu"
  ]
}
