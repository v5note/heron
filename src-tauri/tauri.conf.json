{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heron",
  "version": "0.1.0",
  "identifier": "io.greyheron.heron",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": {
      "cwd": "..",
      "script": "pnpm --dir ui dev"
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "pnpm --dir ui build"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Heron",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../docs/icons/32x32.png",
      "../docs/icons/128x128.png",
      "../docs/icons/128x128@2x.png",
      "../docs/icons/icon.icns",
      "../docs/icons/icon.ico",
      "../docs/icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "resources": [],
    "shortDescription": "Local skill manager",
    "longDescription": "Heron gathers the Agent Skills scattered across Claude Code, Codex, .agents and projects into one versioned store, projects them into the places clients actually scan, and upgrades them with a three-way merge.",
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5QkQ5MTJGNkIxRTI0RkIKUldUN0pCNXJMNUc5dVk0dXVubG9OOEhlb2YyaWJvS3NTbW9HdFFxOTdDbW9iMHlybFJsemdNRTIK",
      "endpoints": [
        "https://github.com/v5note/heron/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
